#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define MOVE    1
#define NUMCHAR 2
#define EXTRA   3

/ {
        behaviors {
                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 29 30 31 32 33 37 38 39>;
                        hold-trigger-on-release;
                };
                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 34 35 36>;
                        hold-trigger-on-release;
                };

                m_lpar_lt: m_lpar_lt {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp LPAR>, <&kp LT>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };
                m_rpar_gt: m_rpar_gt {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp RPAR>, <&kp GT>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };
        };

        combos {
                compatible = "zmk,combos";
                combo_esc {
                        timeout-ms = <50>;
                        key-positions = <2 3>;
                        bindings = <&kp ESC>;
                };
                combo_bspc {
                        timeout-ms = <50>;
                        key-positions = <8 9>;
                        bindings = <&kp BSPC>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <MOVE NUMCHAR>;
                        then-layer = <EXTRA>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
// ╭───────┬───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────┬───────╮
// │  ESC  │   Q   │   W   │   E   │   R   │   T   │   │   Y   │   U   │   I   │   O   │   P   │ BSPC  │
// ├───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┤
// │  TAB  │LGUI A │LALT S │ CTRL D│ SHFT F│   G   │   │   H   │ SHFT J│ CTRL K│LALT L │RGUI ; │  DEL  │
// ╰───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────╯
//         │   Z   │   X   │   C   │   V   │   B   │   │   N   │   M   │   ,   │   .   │   /   │        
//         ╰───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────╯        
//                         │  GUI  │ MOVE  │ SPACE │   │ ENTER │NUMCHAR│ RALT  │                        
//                         ╰───────┴───────┴───────╯   ╰───────┴───────┴───────╯                        
                        bindings = <
   &kp ESC   &kp Q        &kp W            &kp E             &kp R                &kp T                &kp Y             &kp U             &kp I           &kp O           &kp P           &kp BSPC
   &kp TAB   &hml LGUI A  &hml LALT S      &hml LCTRL D      &hml LSHIFT F        &kp G                &kp H             &hmr RSHIFT J     &hmr RCTRL K    &hmr LALT L     &hmr RGUI SEMI  &kp DEL
             &kp Z        &kp X            &kp C             &kp V                &kp B                &kp N             &kp M             &kp COMMA       &kp DOT         &kp FSLH        
                                           &kp LGUI          &mo MOVE             &kp SPACE            &kp RET           &mo NUMCHAR       &kp RALT
                        >;
                };
                move_layer {
                        display-name = "Move Layer";
// ╭───────┬───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────┬───────╮
// │ trans │ none  │ none  │ none  │ none  │ MUTE  │   │ HOME  │  END  │ PG DN │ PG UP │ none  │ trans │
// ├───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┤
// │ trans │ PLAY  │ALT PRV│CTL NXT│SFT BRU│ VOL U │   │ LEFT  │ DOWN  │  UP   │ RIGHT │ none  │ trans │
// ╰───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────╯
//         │ none  │ none  │ none  │ BRI D │ VOL D │   │  APP  │  INS  │ CAPS  │ none  │ none  │        
//         ╰───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────╯        
//                         │ trans │ trans │ trans │   │ trans │ trans │ trans │                        
//                         ╰───────┴───────┴───────╯   ╰───────┴───────┴───────╯                        
                        bindings = <
   &trans    &none        &none            &none             &none                &kp C_MUTE           &kp HOME          &kp END           &kp PG_DN       &kp PG_UP       &none           &trans
   &trans    &kp C_PP     &hml LALT C_PREV &hml LCTRL C_NEXT &hml LSHIFT C_BRI_UP &kp C_VOL_UP         &kp LEFT          &kp DOWN          &kp UP          &kp RIGHT       &none           &trans
             &none        &none            &none             &kp C_BRI_DN         &kp C_VOL_DN         &kp K_APP         &kp INS           &kp CAPS        &none           &none          
                                           &trans            &trans               &trans               &trans            &trans            &trans
                        >;
                };

                numchar_layer {
                        display-name = "Numchar Layer";
// ╭───────┬───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────┬───────╮
// │ trans │   1   │   2   │   3   │   4   │   5   │   │   6   │   7   │   8   │   9   │   0   │ trans │
// ├───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┤
// │ trans │ none  │  ALT  │CTL  ` │SFT  - │   [   │   │   ]   │SFT  = │CTL  ' │ALT  \ │ none  │ trans │
// ╰───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────╯
//         │ none  │ none  │ none  │ none  │  ( <  │   │  ) >  │ none  │ none  │ none  │ none  │        
//         ╰───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────╯        
//                         │ trans │ trans │ trans │   │ trans │ trans │ trans │                        
//                         ╰───────┴───────┴───────╯   ╰───────┴───────┴───────╯                        
                        bindings = <
   &trans    &kp N1       &kp N2           &kp N3            &kp N4               &kp N5               &kp N6            &kp N7            &kp N8          &kp N9          &kp N0          &trans
   &trans    &none        &kp LALT         &hml LCTRL GRAVE  &hml LSHIFT MINUS    &kp LBKT             &kp RBKT          &hmr RSHIFT EQUAL &hmr RCTRL SQT  &hmr RALT BSLH  &none           &trans
             &none        &none            &none             &none                &m_lpar_lt           &m_rpar_gt        &none             &none           &none           &none          
                                           &trans            &trans               &trans               &trans            &trans            &trans
                        >;
                };

                extra_layer {
                        display-name = "Extra Layer";
// ╭───────┬───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────┬───────╮
// │ trans │  F1   │  F2   │  F3   │  F4   │  F5   │   │  F6   │  F7   │  F8   │  F9   │  F10  │ trans │
// ├───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┤
// │ trans │ none  │  ALT  │ CTRL  │ SHFT  │ none  │   │ EP TG │ none  │ none  │  F11  │  F12  │ trans │
// ╰───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────╯
//         │ BT 1  │ BT 2  │ BT 3  │ BT 4  │ BT 5  │   │BT CLR │ZMK STU│ none  │SYS RES│ BOOT  │        
//         ╰───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────╯        
//                         │ trans │ trans │ trans │   │ trans │ trans │ trans │                        
//                         ╰───────┴───────┴───────╯   ╰───────┴───────┴───────╯                        
                        bindings = <
   &trans    &kp F1       &kp F2           &kp F3            &kp F4               &kp F5               &kp F6            &kp F7            &kp F8          &kp F9          &kp F10         &trans
   &trans    &none        &kp LALT         &kp LCTRL         &kp LSHIFT           &none                &ext_power EP_TOG &none             &none           &kp F11         &kp F12         &trans
             &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_SEL 2      &bt BT_SEL 3         &bt BT_SEL 4         &bt BT_CLR        &studio_unlock    &none           &sys_reset      &bootloader          
                                           &trans            &trans               &trans               &trans            &trans            &trans
                        >;
                };
        };
};