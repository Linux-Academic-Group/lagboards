#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                             // Left: bottom row
                             &kp Z        &kp X       &kp C        &kp V         &kp B
                // Left: home row
                &kp ESC      &kp A        &kp S       &kp D        &kp F         &kp G
                // Left: top row
                &kp TAB      &kp Q       &kp W        &kp E        &kp R         &kp T
                  // Left: thumb cluster
                  &kp LGUI &kp LCTRL &mo 1 &kp SPACE &kp LSHIFT

                                // Right: bottom row 
                                &kp SLASH     &kp DOT       &kp COMMA    &kp M     &kp N
                // Right: home row
                &kp APOSTROPHE  &kp SEMICOLON &kp L         &kp K        &kp J     &kp H
                // Right: top row
                &kp BSPC        &kp P         &kp O         &kp I        &kp U     &kp Y
                  // Right: thumb cluster
                  &kp RSHIFT &kp SPACE &mo 2 &kp RET &kp RALT
            >;
        };

        lower_layer {
            bindings = <
                                 // Left: bottom
                                 &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp GRAVE
                // Left: home
                &kp EXCL         &kp AT            &kp HASH          &kp DLLR         &kp PRCNT         &kp CARET
                // Left: top
                &kp GRAVE        &kp N1            &kp N2            &kp N3           &kp N4            &kp N5
                  // Left: thumb
                  &trans &trans &trans &trans &trans

                                  // Right: bottom
                                  &kp BACKSLASH    &kp EQUAL       &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp BACKSLASH
                // Right: home
                &kp RIGHT_BRACKET &kp LEFT_BRACKET &kp RIGHT_ARROW &kp UP_ARROW         &kp DOWN_ARROW        &kp LEFT_ARROW
                // Right: top
                &kp MINUS         &kp N0           &kp N9          &kp N8               &kp N7                &kp N6
                  // Right: thumb
                  &trans &trans &trans &trans &trans
            >;
        };

        raise_layer {
            bindings = <
                             // Left: bottom
                             &none        &none       &none        &none         &none
                // Left: home
                &kp F12      &kp F1      &kp F2       &kp F3       &kp F4        &kp F5
                // Left: top
                &kp GRAVE    &none       &none        &none        &none         &none
                  // Left: thumb
                  &trans &trans &trans &trans &trans

                             // Right: bottom
                             &none        &none           &none          &none         &none
                // Right: home
                &kp F11      &kp F10      &kp F9          &kp F8         &kp F7        &kp F6
                // Right: top
                &kp DELETE   &none        &kp PRINTSCREEN &kp C_MUTE     &kp C_VOL_UP  &kp C_VOL_DN
                  // Right: thumb
                  &trans &trans &trans &studio_unlock &trans
            >;
        };
    };
};
